{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memomatch-indexer",
  "main": "workers/indexer.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ARC_START_BLOCK": "REPLACE_WITH_ARC_MEMO_START_BLOCK",
    "ARC_NETWORK": "mainnet"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memomatch",
      "database_id": "replace-with-cloudflare-d1-id",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/1 * * * *"]
  }
}
