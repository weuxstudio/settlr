{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memomatch-indexer-testnet",
  "main": "workers/indexer.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ARC_NETWORK": "testnet",
    "ARC_RPC_URL": "https://rpc.testnet.arc.io",
    "ARC_START_BLOCK": "REPLACE_WITH_ARC_TESTNET_START_BLOCK"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memomatch-testnet",
      "database_id": "replace-with-cloudflare-testnet-d1-id",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/1 * * * *"] }
}
